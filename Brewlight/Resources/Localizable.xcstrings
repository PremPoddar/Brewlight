    "Installers Homebrew keeps so reinstalls are fast. Safe to delete; they're downloaded again if needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installationsdateien, die Homebrew für schnelle Neuinstallationen aufbewahrt. Löschen ist unbedenklich; sie werden bei Bedarf erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instaladores que Homebrew guarda para reinstalar rápido. Puedes eliminarlos; se volverán a descargar cuando hagan falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installateurs conservés par Homebrew pour des réinstallations rapides. Vous pouvez les supprimer ; ils seront retéléchargés au besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再インストールを速くするため Homebrew が保持しているインストーラです。削除しても、必要になれば再ダウンロードされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew 保留的安装程序，用于快速重新安装。可以删除，需要时会重新下载。"
          }
        }
      }
    },
