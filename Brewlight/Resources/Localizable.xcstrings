    "Bought from the App Store. Homebrew would replace it with the developer's download on the next update, which can lose an App Store licence. Not recommended for paid apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus dem App Store gekauft. Homebrew würde sie beim nächsten Update durch den Download des Entwicklers ersetzen, wodurch eine App-Store-Lizenz verloren gehen kann. Für Kauf-Apps nicht empfohlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprada en la App Store. Homebrew la sustituiría por la descarga del desarrollador en la próxima actualización, lo que puede hacer perder una licencia de la App Store. No recomendado para apps de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Achetée sur l’App Store. Homebrew la remplacerait par le téléchargement du développeur à la prochaine mise à jour, ce qui peut faire perdre une licence App Store. Déconseillé pour les apps payantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App Store で購入されたアプリです。Homebrew は次回のアップデートで開発元のダウンロード版に置き換えるため、App Store のライセンスを失う可能性があります。有料アプリにはおすすめしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此应用购自 App Store。Homebrew 会在下次更新时用开发者的下载版替换它，可能导致 App Store 授权丢失。不建议用于付费应用。"
          }
        }
      }
    },
