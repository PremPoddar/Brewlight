    " is pinned at %@ — %@ available. Unpin to include it in Upgrade All.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " ist bei %@ fixiert – %@ verfügbar. Lösen, um es in „Alle aktualisieren“ einzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " is pinned at %1$@ — %2$@ available. Unpin to include it in Upgrade All."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " está fijado en %@ — hay %@ disponible. Desfíjalo para incluirlo en «Actualizar todo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " est épinglé à %@ — %@ disponible. Désépinglez-le pour l’inclure dans « Tout mettre à niveau »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": " は %@ に固定されています — %@ が利用可能です。「すべてアップグレード」に含めるには固定を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": " 已固定在 %@ — 有 %@ 可用。取消固定即可纳入“全部升级”。"
          }
        }
      }
    },
