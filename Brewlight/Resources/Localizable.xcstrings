    "Homebrew is ignoring packages from %@ until you trust it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew ignoriert Pakete aus %@, bis du ihm vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew omite los paquetes de %@ hasta que confíes en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew ignore les paquets de %@ tant que vous ne lui faites pas confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "信頼するまで、Homebrew は %@ のパッケージをスキップします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你信任 %@ 之前，Homebrew 会跳过其中的软件包。"
          }
        }
      }
    },
    "Homebrew is installed somewhere else…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew ist an einem anderen Ort installiert …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Homebrew está instalado en otro sitio…"
          }
        },
        "fr": {
