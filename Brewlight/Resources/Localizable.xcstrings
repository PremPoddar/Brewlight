        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight の操作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight 操作"
          }
        }
      }
    },
    "Brewlight sends nothing about you anywhere. Network requests go to formulae.brew.sh, GitHub, and package homepages (for icons) only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight sendet keinerlei Daten über dich. Netzwerkanfragen gehen nur an formulae.brew.sh, GitHub und Paket-Websites (für Symbole)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight no envía nada sobre ti. Las solicitudes de red van solo a formulae.brew.sh, GitHub y los sitios de los paquetes (para los iconos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight n’envoie rien à votre sujet. Les requêtes réseau vont uniquement vers formulae.brew.sh, GitHub et les sites des paquets (pour les icônes)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight があなたに関する情報を送信することはありません。ネットワーク通信は formulae.brew.sh、GitHub、およびパッケージのウェブサイト（アイコン取得用）のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight 不会发送任何关于你的信息。网络请求只发往 formulae.brew.sh、GitHub 以及软件包网站（用于获取图标）。"
          }
        }
      }
    },
    "Brewlight uses its amber accent; system accent colours apply to controls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight nutzt seinen Bernstein-Akzent; für Bedienelemente gilt die Systemakzentfarbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight usa su acento ámbar; el color de acento del sistema se aplica a los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight utilise son accent ambre ; la couleur d’accent du système s’applique aux commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight は独自のアンバーのアクセントを使います。システムのアクセントカラーはコントロールに適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight 使用自己的琥珀色强调色；系统强调色用于控件。"
          }
        }
      }
    },
