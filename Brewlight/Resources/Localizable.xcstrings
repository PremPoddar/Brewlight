    "%lld installed packages come from this tap. Homebrew will refuse until they are uninstalled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld installierte Pakete stammen aus diesem Tap. Homebrew verweigert das Entfernen, bis sie deinstalliert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay %lld paquetes instalados de este tap. Homebrew se negará hasta que se desinstalen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld paquets installés proviennent de ce tap. Homebrew refusera tant qu’ils ne sont pas désinstallés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このタップからインストールされたパッケージが %lld 個あります。アンインストールするまで Homebrew は拒否します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有 %lld 个已安装的软件包来自此 tap。卸载它们之前，Homebrew 会拒绝此操作。"
          }
        }
      }
    },
