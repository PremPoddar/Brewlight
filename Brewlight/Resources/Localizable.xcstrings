        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight は独立したアプリで、Homebrew プロジェクトや Apple とは関係ありません。Spotlight は Apple Inc. の商標です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brewlight 是独立应用，与 Homebrew 项目或 Apple 无关。Spotlight 是 Apple Inc. 的商标。"
