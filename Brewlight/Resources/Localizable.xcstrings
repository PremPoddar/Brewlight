    "This step needs a terminal (it asked for input Brewlight can't provide).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Schritt braucht ein Terminal (er hat nach Eingaben gefragt, die Brewlight nicht liefern kann)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este paso necesita un terminal (pidió una entrada que Brewlight no puede proporcionar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette étape nécessite un terminal (elle a demandé une saisie que Brewlight ne peut pas fournir)."
          }
        },
        "ja": {
